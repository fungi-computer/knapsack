{
  "name": "@fungi.computer/knapsack",
  "version": "0.4.30",
  "author": "Levi <levi@technomancy.dev>",
  "description": "Agent tool connections projected into Mycelium capability sources",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./files-patch": {
      "types": "./dist/files-patch.d.ts",
      "import": "./dist/files-patch.js"
    },
    "./files-read": {
      "types": "./dist/files-read.d.ts",
      "import": "./dist/files-read.js"
    },
    "./files-search": {
      "types": "./dist/files-search.d.ts",
      "import": "./dist/files-search.js"
    },
    "./patch": {
      "types": "./dist/patch.d.ts",
      "import": "./dist/patch.js"
    },
    "./files-read-codec": {
      "types": "./dist/files-read-codec.d.ts",
      "import": "./dist/files-read-codec.js"
    },
    "./ui/browser": {
      "types": "./dist/ui-browser.d.ts",
      "import": "./dist/ui-browser.js"
    }
  },
  "files": [
    "dist",
    "docs/api",
    "README.md",
    "LICENSE",
    "LICENSE.codex"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "smoke": "node --input-type=module -e \"import('./dist/index.js').then(({ Knapsack }) => { if (!Knapsack) process.exit(1); })\""
  },
  "dependencies": {
    "@fungi.computer/cairn": "0.1.0",
    "@fungi.computer/forage": "0.5.3",
    "@fungi.computer/mule": "0.4.0",
    "@fungi.computer/mycelium": "0.5.0",
    "@fungi.computer/whistle": "0.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "diff": "8.0.4",
    "effect": "4.0.2",
    "ignore": "7.0.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.2",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "24.13.3",
    "eventsource": "5.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/knapsack.git"
  }
}
